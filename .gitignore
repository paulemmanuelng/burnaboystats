# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Stats monitor local output
drift-report.md
refresh-pr-body.md

# redesign drop folder (local only)
/design

# Stray verification artifacts (downloaded chart pages, test card renders)
/card-*.png
/*.html

# The designer's handoff bundle (1.5MB of .dc.html prototypes + specs). Kept on
# disk, not in the repo: source comments across app/ cite these files by name as
# the source of truth for their values — app/page.tsx names "Burna Boy Stats
# .dc.html", song.module.css names "Song.dc.html, values verbatim" — so it has
# to stay readable. It is reference, never imported, and 40 HTML prototypes do
# not belong in the build.
design_handoff_burnaboystats/
